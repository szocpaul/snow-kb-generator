# --- ServiceNow kapcsolat ---
# A Table API alapja: https://<SNOW_INSTANCE>/api/now/table/
SNOW_INSTANCE=your-instance.service-now.com
SNOW_USERNAME=api-user
SNOW_PASSWORD=********
# (alternatíva: OAuth token alapú hitelesítés — később dönthetünk)

# --- DSPy / LM ---
# A generáláshoz használt modell. Ajánlott: erős utasításkövető (gpt-4o, claude, stb.).
OPENAI_API_KEY=sk-...
# GEPA reflection-hez külön (erősebb / drágább) modell javasolt.
OPENAI_API_KEY_REFLECTION=sk-...

# (opcionális) Ha más providert használunk:
# ANTHROPIC_API_KEY=...
# AZURE_OPENAI_API_KEY=...
