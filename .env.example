# --- ServiceNow kapcsolat ---
# A Table API alapja: https://<SNOW_INSTANCE>/api/now/table/
SNOW_INSTANCE=your-instance.service-now.com
SNOW_USERNAME=api-user
SNOW_PASSWORD=********
# (alternative: OAuth token based authentication — we decide about it later)

# --- DSPy / LM ---
# The model used for the generation. Recommended: a strong instruction follower (gpt-4o, claude, etc.).
#
# NOTE: If pipeline.use_pi_auth: true is set in the config.yaml,
# then THIS API KEY IS NOT NEEDED — the dspy-lm-auth module of the Pi Agent GLM
# the subscription authentication is used (pip install dspy-lm-auth).
OPENAI_API_KEY=sk-...
# A separate (stronger / more expensive) model is recommended for the GEPA reflection.
OPENAI_API_KEY_REFLECTION=sk-...

# --- Pipeline webhook (FastAPI server) ---
# The ServiceNow UI Action script sends this key to the FastAPI server.
# Generate a random key: openssl rand -hex 32
SNOW_WEBHOOK_API_KEY=change-this-to-a-random-key

# (optional) If we use another provider:
# ANTHROPIC_API_KEY=...
# AZURE_OPENAI_API_KEY=...
