# --- ServiceNow kapcsolat ---
# A Table API alapja: https://<SNOW_INSTANCE>/api/now/table/
SNOW_INSTANCE=your-instance.service-now.com
SNOW_USERNAME=api-user
SNOW_PASSWORD=********
# (alternative: OAuth token based authentication — we decide about it later)

# --- DSPy / LM ---
# The model used for the generation. Recommended: a strong instruction follower (gpt-4o, claude, etc.).
OPENAI_API_KEY=sk-...
# A separate (stronger / more expensive) model is recommended for the GEPA reflection.
OPENAI_API_KEY_REFLECTION=sk-...

# (optional) If we use another provider:
# ANTHROPIC_API_KEY=...
# AZURE_OPENAI_API_KEY=...
