# --- ServiceNow kapcsolat ---
# A Table API alapja: https://<SNOW_INSTANCE>/api/now/table/
SNOW_INSTANCE=your-instance.service-now.com
SNOW_USERNAME=api-user
SNOW_PASSWORD=********
# (alternatíva: OAuth token alapú hitelesítés — később dönthetünk)

# --- DSPy / LM ---
# A generáláshoz használt modell. Ajánlott: erős utasításkövető (gpt-4o, claude, stb.).
#
# MEGJEGYZÉS: Ha a config.yaml-ben pipeline.use_pi_auth: true van beállítva,
# akkor EZ AZ API KULCS NEM KELL — a dspy-lm-auth modul a Pi Agent GLM
# előfizetés hitelesítését használja (pip install dspy-lm-auth).
OPENAI_API_KEY=sk-...
# GEPA reflection-hez külön (erősebb / drágább) modell javasolt.
OPENAI_API_KEY_REFLECTION=sk-...

# --- TypeSafe (kalibrált audience-döntés, spec 013) ---
# A System One API kulcsa. Csak akkor kell, ha config.yaml-ben
# audience_decision.enabled: true. Nélküle a pipeline fail-open módon
# a generatív audience-útra esik vissza.
TYPESAFE_API_KEY=ts-...
# (opcionális) Pinnelt döntési modell felülírása — alapból a config.yaml
# audience_decision.model érvényes. Lebegő alias helyett pinnelt verzió kell.
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# --- Pipeline webhook (FastAPI szerver) ---
# Ezt a kulcsot a ServiceNow UI Action script küldi el a FastAPI szervernek.
# Generálj egy véletlenszerű kulcsot: openssl rand -hex 32
SNOW_WEBHOOK_API_KEY=change-this-to-a-random-key

# (opcionális) Ha más providert használunk:
# ANTHROPIC_API_KEY=...
# AZURE_OPENAI_API_KEY=...
