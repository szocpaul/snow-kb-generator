   "label_text": "sys_ui_action:createKbArticle",
   "text": "<record_update sys_domain=\"global\" table=\"sys_ui_action\"><sys_ui_action action=\"INSERT_OR_UPDATE\"><action_name>create_kb_server_action</action_name><active>true</active><client>false</client><client_script_v2><![CDATA[function onClick(g_form) {\n\n}]]></client_script_v2><comments/><condition>current.state == '3'</condition><form_action>true</form_action><form_button>true</form_button><form_button_v2>false</form_button_v2><form_context_menu>false</form_context_menu><form_link>false</form_link><form_menu_button_v2>false</form_menu_button_v2><form_style/><format_for_configurable_workspace>false</format_for_configurable_workspace><hint/><isolate_script>false</isolate_script><list_action>false</list_action><list_banner_button>false</list_banner_button><list_button>false</list_button><list_choice>false</list_choice><list_context_menu>false</list_context_menu><list_link>false</list_link><list_save_with_form_button>false</list_save_with_form_button><list_style/><messages/><name>createKbArticle</name><onclick/><order>100</order><script><![CDATA[// ============================================================================\n// UI Action Script: Create KB Article (SERVER-SIDE)\n// ============================================================================\n// This script runs on the ServiceNow server and calls our FastAPI server on\n// the VPS directly from there. It handles the 200, 409 (Duplicate),\n// 422 (Missing Group) and other error codes.\n// ============================================================================\n\n// 1. The 'current' variable automatically holds the opened Story\nvar storyId = current.number;\n\n// --- SETTINGS ---\n// The key matches the .env SNOW_WEBHOOK_API_KEY field. Provide the real value\n// in ServiceNow (UI Action property or Script Include global); in the repo\n// there is only a placeholder.\nvar apiUrl = 'http://10.20.30.40:8000/generate-kb';\nvar apiKey = 'REDACTED-API-KEY';\n\n// 2. Assemble the payload\nvar payload = {};\npayload.story_id = storyId + ''; // force to string\npayload.push = true;\n// The user has already approved the generation by clicking the button,\n// so we send force_update=true to overwrite the old one if there is one.\npayload.force_update = true; \n\n// 3. Send the REST call to our VPS server\nvar restMessage = new sn_ws.RESTMessageV2();\nrestMessage.setEndpoint(apiUrl);\nrestMessage.setHttpMethod('POST');\nrestMessage.setRequestHeader('Content-Type', 'application/json');\nrestMessage.setRequestHeader('X-API-Key', apiKey);\nrestMessage.setRequestBody(JSON.stringify(payload));\nrestMessage.setRequestTimeout(120000); // 120 second timeout because of the GLM generation\n\nvar response = restMessage.execute();\nvar httpStatus = response.getStatusCode();\nvar responseBody = response.getBody();\n\n// 4. Process the response based on the HTTP status code\nif (httpStatus === 200) {\n    // Successful generation or update\n    var result = JSON.parse(responseBody);\n    if (result.success && result.kb_url) {\n        current.work_notes = \"KB article created/updated: \" + result.kb_url + \" (\" + result.title + \")\";\n    } else {\n        current.work_notes = \"KB generation finished, but response was invalid.\";\n    }\n} else if (httpStatus === 422) {\n    // Unprocessable Entity (e.g. the Assignment Group is missing)\n    var errData = JSON.parse(responseBody).detail;\n    current.work_notes = \"Generation aborted: \" + (errData.message || 'Missing required data (e.g. Assignment Group).');\n    gs.addErrorMessage(\"Error: the Assignment Group field is mandatory on the Story!\");\n} else if (httpStatus === 409) {\n    // Conflict (a KB article already exists for the Story)\n    current.work_notes = \"Warning: a KB article already exists for this Story. Pressing the button again overwrites the old one.\";\n    gs.addInfoMessage(\"A KB article already exists. Press the button again to overwrite it!\");\n} else {\n    // Other errors (e.g. 500 Internal Server Error, or 0 Connection Refused)\n    current.work_notes = \"An error occurred (HTTP \" + httpStatus + \"): \" + responseBody.substring(0, 150);\n    gs.addErrorMessage(\"Error during generation (HTTP \" + httpStatus + \")\");\n}\n\n// 5. Set the redirect: stay on the Story after the refresh\naction.setRedirectURL(current);\naction.setReturnURL(current);\n]]></script><show_insert>false</show_insert><show_multiple_update>false</show_multiple_update><show_query>false</show_query><show_update>true</show_update><sys_class_name>sys_ui_action</sys_class_name><sys_created_by>developer</sys_created_by><sys_created_on>2026-07-13 18:23:25</sys_created_on><sys_domain>global</sys_domain><sys_domain_path>/</sys_domain_path><sys_id>anon0000000000000000000000000004</sys_id><sys_mod_count>14</sys_mod_count><sys_name>createKbArticle</sys_name><sys_overrides/><sys_package display_value=\"Global\" source=\"global\">global</sys_package><sys_policy/><sys_scope display_value=\"Global\">global</sys_scope><sys_update_name>sys_ui_action_anon0000000000000000000000000004</sys_update_name><sys_updated_by>developer</sys_updated_by><sys_updated_on>2026-07-16 18:16:15</sys_updated_on><table>rm_story</table><ui11_compatible>true</ui11_compatible><ui16_compatible>false</ui16_compatible></sys_ui_action><sys_es_latest_script action=\"INSERT_OR_UPDATE\"><id>anon0000000000000000000000000004</id><sys_created_by>developer</sys_created_by><sys_created_on>2026-07-13 18:23:19</sys_created_on><sys_id>anon0000000000000000000000000003</sys_id><sys_mod_count>1</sys_mod_count><sys_updated_by>developer</sys_updated_by><sys_updated_on>2026-07-13 18:31:12</sys_updated_on><table>sys_ui_action</table><use_es_latest>false</use_es_latest></sys_es_latest_script></record_update>",
